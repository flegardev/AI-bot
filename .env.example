# Copy this file to .env and fill in your values

# Binance API credentials (leave blank for paper trading)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Use Binance testnet for safe testing (true/false)
USE_TESTNET=true

# Live trading requires both LIVE_TRADING_ENABLED=true and explicit console confirmation.
# Keep REQUIRE_TESTNET_FOR_LIVE=true until you have completed testnet validation.
LIVE_TRADING_ENABLED=false
REQUIRE_TESTNET_FOR_LIVE=true

# Trading mode: backtest | paper | live
MODE=paper

# Symbol to trade
SYMBOL=BTC/USDT

# Simulation balance for backtest/paper/demo sizing only. Live mode always fetches
# the exchange balance and fails closed if it cannot be verified.
ACCOUNT_BALANCE=10000

# Risk kill switches
MAX_OPEN_POSITIONS=1
MAX_DAILY_LOSS_PCT=0.03
MAX_DRAWDOWN_PCT=0.10

# Backtest date range (YYYY-MM-DD)
BACKTEST_START=2024-01-01
BACKTEST_END=2024-12-31
INITIAL_BALANCE=10000
BACKTEST_FEE_RATE=0.001
BACKTEST_SLIPPAGE_PCT=0.0005
TRAIN_ML_AFTER_BACKTEST=false

# Runtime state (paper positions and live reconciliation journal)
STATE_DIR=state
