# Safe defaults. Copy to .env; never put real credentials in source control.
TRADING_MODE=paper
BROKER=mt5
ENABLE_LIVE_TRADING=false
I_UNDERSTAND_REAL_MONEY_RISK=false

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=
MT5_SYMBOL=EURUSD
MT5_MAGIC_NUMBER=260727

BINANCE_API_KEY=
BINANCE_API_SECRET=
USE_TESTNET=true

RISK_PER_TRADE=0.01
MIN_RISK_REWARD=2.0
MAX_OPEN_POSITIONS=1
MAX_DAILY_LOSS_PCT=0.03
MAX_DRAWDOWN_PCT=0.10
MAX_PORTFOLIO_RISK_PCT=0.03
MAX_SYMBOL_EXPOSURE_PCT=1.0
MAX_SPREAD=0.0005
MAX_SLIPPAGE=0.0005
STALE_PRICE_SECONDS=120

BACKTEST_START=2024-01-01
BACKTEST_END=2024-12-31
INITIAL_BALANCE=10000
BACKTEST_FEE_RATE=0.0005
BACKTEST_SPREAD=0.0001
BACKTEST_SLIPPAGE_PCT=0.0001
BACKTEST_LATENCY_BARS=1
# Constant debit in account currency per lot per UTC day; broker rollover varies.
BACKTEST_SWAP_PER_LOT_DAY=0
# Approximate FX calendar: Fri 22:00 to Sun 22:00 UTC closed. Use 24/7 for crypto.
MARKET_CALENDAR=fx

USE_ML_FILTER=false
ML_MIN_SAMPLES=200
ML_CONFIDENCE_THRESHOLD=0.70
TRAIN_ML_AFTER_BACKTEST=false

STATE_DIR=state
ARTIFACT_DIR=artifacts
